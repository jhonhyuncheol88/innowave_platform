# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 일반)
# 주의: 웹 API 키는 비밀이 아니지만, .env 파일 자체는 커밋하지 말 것
VITE_FIREBASE_API_KEY=AIzaSyDAXnMIK-0lb7ZN2wyujOzSBAmLX5soncs
VITE_FIREBASE_AUTH_DOMAIN=innowave-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=innowave-platform
VITE_FIREBASE_STORAGE_BUCKET=innowave-platform.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=107507030569
VITE_FIREBASE_APP_ID=1:107507030569:web:2285c19f1db8bac9bbda38
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3 사이트 키) — 봇/스크래핑 방어
# https://www.google.com/recaptcha/admin/create (v3)
# Firebase 콘솔 > App Check > Web App > reCAPTCHA secret 등록
VITE_FIREBASE_APPCHECK_KEY=

# 개발용 App Check 디버그 토큰 (Firebase 콘솔 > App Check > Manage debug tokens)
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
